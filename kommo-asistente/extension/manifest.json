{
  "manifest_version": 3,
  "name": "Kommo Asistente",
  "version": "1.0.0",
  "description": "Captura mensajes de Kommo y sugiere respuestas con un chatbot local de Python.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://*.kommo.com/*",
    "https://*.amocrm.com/*"
  ],
  "action": {
    "default_title": "Kommo Asistente",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kommo.com/*",
        "https://*.amocrm.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
